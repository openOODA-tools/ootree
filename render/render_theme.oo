// # Theme and Terminal Renderer - Color Palettes and Entity Styling
//
// Logline: Hydrates terminal palette from ~/.openooda/theme.oot and colors tree entities.
//
// Setup: Requires FsReadCap and EnvCap. Operates with zero ambient authority.
//
// Beats:
//   1. Resolve theme name from OODA_THEME or ~/.openooda/theme.oot with fallback.
//   2. Map filesystem entity types (directories, code, archives) to ANSI color codes.
//   3. Provide theme-specific branch and directory color palettes.
//   4. Support uncolored mode for pipe and plain output.

import "std/fs/process/env.oo";

pub fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

pub fn term_reset() -> String {
    return ansi_esc() + "[0m";
}

pub fn parse_theme_val(line: String, key: String) -> String {
    let trimmed: String = str_trim(line);
    if !str_starts_with(trimmed, key) { return ""; }
    let rest: String = str_trim(str_slice(trimmed, chars_len(key), chars_len(trimmed)));
    if !str_starts_with(rest, "=") { return ""; }
    let mut val: String = str_trim(str_slice(rest, 1, chars_len(rest)));
    if str_starts_with(val, "\"") && str_ends_with(val, "\"") {
        let n: Int = chars_len(val);
        if n >= 2 { val = str_slice(val, 1, n - 1); }
    }
    return val;
}

pub fn parse_theme_key(content: String, key: String) -> String {
    let n: Int = chars_len(content);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(content, i);
        if c == "\n" {
            let v: String = parse_theme_val(cur, key);
            if v != "" { return v; }
            cur = "";
        } else if c != "\r" {
            cur = cur + c;
        }
        i = i + 1;
    }
    if cur != "" {
        let v: String = parse_theme_val(cur, key);
        if v != "" { return v; }
    }
    return "";
}

pub fn resolve_tree_theme(fs: &FsReadCap, env: &EnvCap, override_name: String) -> String {
    if chars_len(override_name) > 0 { return override_name; }
    let env_t: Result[String, String] = env_get(env, "OODA_THEME");
    if env_t.is_ok() {
        let t: String = match env_t { Ok(s) => s, Err(_) => "" };
        if t != "" { return t; }
    }
    let env_home: Result[String, String] = env_get(env, "OODA_HOME");
    let mut home: String = match env_home { Ok(s) => s, Err(_) => "" };
    if home == "" {
        let env_w: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
        home = match env_w { Ok(s) => s, Err(_) => "" };
    }
    if home == "" {
        let env_h: Result[String, String] = env_get(env, "HOME");
        home = match env_h { Ok(s) => s, Err(_) => "" };
    }
    let p: String = if str_ends_with(home, "/") { home + ".openooda/theme.oot" } else { home + "/.openooda/theme.oot" };
    let r: Result[String, String] = read_file(fs, p);
    if r.is_err() { return "classic"; }
    let content: String = match r { Ok(s) => s, Err(_) => "" };
    let t: String = parse_theme_key(content, "theme");
    return if t != "" { t } else { "classic" };
}

pub fn theme_dir_color(theme: String) -> String {
    let esc: String = ansi_esc();
    if str_index_of(theme, "dracula") >= 0 { return esc + "[1;35m"; }
    if str_index_of(theme, "cyberpunk") >= 0 { return esc + "[1;33m"; }
    if str_index_of(theme, "amber") >= 0 { return esc + "[1;33m"; }
    if str_index_of(theme, "nord") >= 0 { return esc + "[1;34m"; }
    if str_index_of(theme, "matrix") >= 0 { return esc + "[1;32m"; }
    return esc + "[1;34m";
}

pub fn theme_branch_color(theme: String) -> String {
    let esc: String = ansi_esc();
    if str_index_of(theme, "cyberpunk") >= 0 { return esc + "[36m"; }
    if str_index_of(theme, "amber") >= 0 { return esc + "[33m"; }
    if str_index_of(theme, "matrix") >= 0 { return esc + "[32m"; }
    if str_index_of(theme, "dracula") >= 0 { return esc + "[38;5;244m"; }
    return esc + "[38;5;240m";
}

pub fn style_entity_name(name: String, is_dir: Bool, no_color: Bool, theme: String) -> String {
    if no_color { return name; }
    let esc: String = ansi_esc();
    let reset: String = term_reset();
    if is_dir {
        return theme_dir_color(theme) + name + reset;
    }
    if str_ends_with(name, ".oo") || str_ends_with(name, ".oot") {
        return esc + "[1;36m" + name + reset;
    }
    if str_ends_with(name, ".tar") || str_ends_with(name, ".gz") || str_ends_with(name, ".zst") || str_ends_with(name, ".zip") {
        return esc + "[1;31m" + name + reset;
    }
    if str_ends_with(name, ".md") || str_ends_with(name, ".txt") {
        return esc + "[32m" + name + reset;
    }
    if str_starts_with(name, ".") {
        return esc + "[38;5;244m" + name + reset;
    }
    return name;
}
