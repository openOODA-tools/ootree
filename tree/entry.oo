// # Tree Entry and Statistics Models
//
// Logline: Encapsulates directory traversal statistics and entry sorting logic.
//
// Setup: Pure value type model and sorter. Zero ambient authority.
//
// Beats:
//   1. Define TreeStats structure tracking directory and file tallies.
//   2. Provide lexicographic code point string comparison.
//   3. Sort directory entries with directories first and alphabetical ordering.


pub type TreeStats = struct {
    dirs: Int,
    files: Int,
    total_bytes: Int
};

pub fn make_tree_stats() -> TreeStats {
    return TreeStats { dirs: 0, files: 0, total_bytes: 0 };
}

fn code_of(c: String) -> Int {
    if chars_len(c) != 1 { return 0; }
    return byte_at(c, 0) & 255;
}

pub fn compare_strings(a: String, b: String) -> Int {
    let na: Int = chars_len(a);
    let nb: Int = chars_len(b);
    let m: Int = if na < nb { na } else { nb };
    let mut i: Int = 0;
    while i < m {
        let d: Int = code_of(char_at(a, i)) - code_of(char_at(b, i));
        if d != 0 { return d; }
        i = i + 1;
    }
    return na - nb;
}

pub fn sort_names(names: List[String]) -> List[String] {
    let mut arr: List[String] = names;
    let n: Int = list_len(arr);
    let mut i: Int = 0;
    while i < n {
        let mut j: Int = i + 1;
        while j < n {
            let a: String = list_get(arr, i);
            let b: String = list_get(arr, j);
            if compare_strings(a, b) > 0 {
                arr = list_set(arr, i, b);
                arr = list_set(arr, j, a);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return arr;
}
